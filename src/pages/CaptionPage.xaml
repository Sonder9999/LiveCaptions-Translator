<Page
    x:Class="LiveCaptionsTranslator.CaptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="CaptionPage"
    JournalEntry.KeepAlive="True"
    mc:Ignorable="d">

    <Grid Margin="5,5,15,5">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="OriginalCaption_Row" Height="Auto" />
            <RowDefinition x:Name="TranslatedCaption_Row" Height="*" />
            <RowDefinition x:Name="CaptionLogCard_Row" Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style x:Key="CaptionBlockStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <ui:Card
            Grid.Row="0"
            Padding="8"
            VerticalAlignment="Stretch"
            PreviewMouseWheel="OriginalCard_PreviewMouseWheel">
            <TextBlock
                x:Name="OriginalCaption"
                Background="Transparent"
                Cursor="Hand"
                FontSize="15"
                MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                Style="{StaticResource CaptionBlockStyle}"
                Text="{Binding DisplayOriginalCaption, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="Click to Copy, Ctrl+Scroll to Resize Font" />
        </ui:Card>

        <ui:Card
            Grid.Row="1"
            MinHeight="43"
            Margin="0,3,0,0"
            Padding="8,6,8,6"
            VerticalAlignment="Stretch"
            PreviewMouseWheel="TranslatedCard_PreviewMouseWheel">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    x:Name="TranslatedSegmentsControl"
                    ItemsSource="{Binding EngineTranslations, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,2,0,2"
                                Padding="6,4,6,4"
                                Background="#08FFFFFF"
                                CornerRadius="4"
                                Cursor="Hand"
                                MouseLeftButtonDown="EngineTranslationRow_MouseLeftButtonDown"
                                Tag="{Binding PureTranslation}"
                                ToolTip="Click to Copy This Engine's Translation, Ctrl+Scroll to Resize Font">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Grid.Column="0"
                                        MinWidth="105"
                                        Margin="0,1,10,1"
                                        Padding="6,2,6,2"
                                        VerticalAlignment="Top"
                                        Background="{ui:ThemeResource ControlFillColorSecondaryBrush}"
                                        CornerRadius="4"
                                        Visibility="{Binding EngineBadgeVisibility}">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Opacity="0.85"
                                            Text="{Binding EngineBadgeText}" />
                                    </Border>

                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="{Binding TranslatedFontSize, RelativeSource={RelativeSource AncestorType=local:CaptionPage}}"
                                        Style="{StaticResource CaptionBlockStyle}"
                                        Text="{Binding MainDisplayText, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </ui:Card>

        <ui:Card
            x:Name="LogCards"
            Grid.Row="2"
            Margin="0,3,0,5"
            Padding="8"
            VerticalAlignment="Top"
            Background="Transparent"
            BorderBrush="#00000000">
            <ItemsControl
                x:Name="LogCardItems"
                MinHeight="50"
                ItemsSource="{Binding DisplayLogCards, UpdateSourceTrigger=PropertyChanged}"
                VirtualizingPanel.IsVirtualizing="True">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,5"
                            Padding="10,5,10,5"
                            BorderBrush="#20000000"
                            BorderThickness="0,1,0,0">
                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <ui:Card
                                    Grid.Row="0"
                                    Padding="8"
                                    VerticalAlignment="Stretch">
                                    <TextBlock
                                        x:Name="OriginalCaptionLog"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        FontSize="12"
                                        MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"
                                        Style="{StaticResource CaptionBlockStyle}"
                                        Text="{Binding SourceText}"
                                        ToolTip="Click To Copy" />
                                </ui:Card>
                                <ui:Card
                                    Grid.Row="1"
                                    Margin="0,3,0,0"
                                    Padding="8"
                                    VerticalAlignment="Stretch">
                                    <TextBlock
                                        x:Name="TranslatedCaptionLog"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        FontSize="16"
                                        MouseLeftButtonDown="LogTranslation_MouseLeftButtonDown"
                                        Style="{StaticResource CaptionBlockStyle}"
                                        Text="{Binding TranslatedText}"
                                        ToolTip="Click To Copy" />
                                </ui:Card>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ui:Card>

    </Grid>
</Page>
