<Window
    x:Class="LiveCaptionsTranslator.SettingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Configure Engine"
    Width="460"
    SizeToContent="Height"
    Background="Transparent"
    AllowsTransparency="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">

    <Border
        Margin="10"
        Background="#242426"
        BorderBrush="#3C3C40"
        BorderThickness="1"
        CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="18"
                Direction="270"
                Opacity="0.45"
                ShadowDepth="4"
                Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
                <RowDefinition Height="1" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Dialog Header -->
            <Grid
                Grid.Row="0"
                Margin="20,14,16,14"
                Background="Transparent"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,8,0"
                        FontSize="16"
                        Foreground="#60CDFF"
                        Symbol="Settings16" />
                    <TextBlock
                        x:Name="DialogTitleText"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Configure Engine - OpenAI" />
                </StackPanel>

                <ui:Button
                    Grid.Column="1"
                    Width="26"
                    Height="26"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CancelButton_Click"
                    ToolTip="Close">
                    <ui:SymbolIcon
                        FontSize="13"
                        Foreground="#888888"
                        Symbol="Dismiss16" />
                </ui:Button>
            </Grid>

            <Border Grid.Row="1" Background="#333337" />

            <!-- Dialog Body -->
            <ScrollViewer
                Grid.Row="2"
                MaxHeight="470"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,16,20,16" Orientation="Vertical">

                    <!-- Engine Service Selector + Multi-Config Profile Switcher -->
                    <StackPanel Margin="0,0,0,14" Orientation="Vertical">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#CCCCCC"
                                Text="Engine Service (服务接口)" />

                            <StackPanel
                                x:Name="ProfilePanel"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#888888"
                                    Text="Profile:" />
                                <ui:Button
                                    Width="22"
                                    Height="22"
                                    Padding="0"
                                    Background="#1C1C1E"
                                    BorderBrush="#383838"
                                    Click="PriorProfile_Click"
                                    ToolTip="Previous Config Profile">
                                    <ui:SymbolIcon FontSize="10" Symbol="ChevronLeft12" />
                                </ui:Button>
                                <TextBlock
                                    x:Name="ProfileIndexText"
                                    Margin="6,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="#CCCCCC"
                                    Text="1/1" />
                                <ui:Button
                                    Width="22"
                                    Height="22"
                                    Margin="0,0,6,0"
                                    Padding="0"
                                    Background="#1C1C1E"
                                    BorderBrush="#383838"
                                    Click="NextProfile_Click"
                                    ToolTip="Next Config Profile">
                                    <ui:SymbolIcon FontSize="10" Symbol="ChevronRight12" />
                                </ui:Button>
                                <ui:Button
                                    Width="22"
                                    Height="22"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    Background="#1C1C1E"
                                    BorderBrush="#383838"
                                    Click="NewProfile_Click"
                                    ToolTip="New Config Profile">
                                    <ui:SymbolIcon FontSize="10" Symbol="Add12" />
                                </ui:Button>
                                <ui:Button
                                    Width="22"
                                    Height="22"
                                    Padding="0"
                                    Background="#1C1C1E"
                                    BorderBrush="#383838"
                                    Click="DeleteProfile_Click"
                                    ToolTip="Delete Current Profile">
                                    <ui:SymbolIcon FontSize="10" Symbol="Delete12" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>

                        <ComboBox
                            x:Name="EngineServiceComboBox"
                            Height="34"
                            Padding="10,5,10,5"
                            Background="#1C1C1E"
                            BorderBrush="#383838"
                            DisplayMemberPath="DisplayName"
                            FontSize="12.5"
                            Foreground="White"
                            SelectedValuePath="ApiName"
                            SelectionChanged="EngineServiceComboBox_SelectionChanged" />
                    </StackPanel>

                    <!-- No-Config Engine Notice -->
                    <Border
                        x:Name="FreeEngineNoticeBorder"
                        Margin="0,0,0,14"
                        Padding="12,10,12,10"
                        Background="#1C1C1E"
                        BorderBrush="#383838"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="#60CDFF"
                                Symbol="Info16" />
                            <TextBlock
                                Width="360"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#CCCCCC"
                                Text="该翻译服务为免配置接口，无需填写密钥。点击右下角「Save Changes」即可将其加入引擎列表并启用，也可点击「测试连接」验证联通性。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- App ID / App Key Field (Baidu / Youdao) -->
                    <StackPanel
                        x:Name="AppIdFieldPanel"
                        Margin="0,0,0,14"
                        Orientation="Vertical"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="AppIdLabelText"
                            Margin="0,0,0,6"
                            FontSize="12"
                            Foreground="#CCCCCC"
                            Text="App ID (应用 ID)" />
                        <ui:TextBox
                            x:Name="AppIdTextBox"
                            Height="34"
                            Padding="10,5,10,5"
                            Background="#1C1C1E"
                            BorderBrush="#383838"
                            ClearButtonEnabled="False"
                            FontSize="12.5"
                            Foreground="White"
                            PlaceholderText="Enter App ID / App Key" />
                    </StackPanel>

                    <!-- API Key / Secret Field with Eye Toggle -->
                    <StackPanel
                        x:Name="ApiKeyFieldPanel"
                        Margin="0,0,0,14"
                        Orientation="Vertical">
                        <TextBlock
                            x:Name="ApiKeyLabelText"
                            Margin="0,0,0,6"
                            FontSize="12"
                            Foreground="#CCCCCC"
                            Text="API Key (密钥)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <PasswordBox
                                x:Name="ApiKeyPasswordBox"
                                Grid.Column="0"
                                Height="34"
                                Padding="10,5,10,5"
                                VerticalContentAlignment="Center"
                                Background="#1C1C1E"
                                BorderBrush="#383838"
                                FontSize="12.5"
                                Foreground="White"
                                PasswordChanged="ApiKeyPasswordBox_PasswordChanged" />

                            <ui:TextBox
                                x:Name="ApiKeyTextBox"
                                Grid.Column="0"
                                Height="34"
                                Padding="10,5,10,5"
                                Background="#1C1C1E"
                                BorderBrush="#383838"
                                ClearButtonEnabled="False"
                                FontSize="12.5"
                                Foreground="White"
                                PlaceholderText="sk-..."
                                TextChanged="ApiKeyTextBox_TextChanged"
                                Visibility="Collapsed" />

                            <ui:Button
                                x:Name="ToggleKeyVisibilityButton"
                                Grid.Column="1"
                                Width="34"
                                Height="34"
                                Margin="6,0,0,0"
                                Padding="0"
                                Background="#1C1C1E"
                                BorderBrush="#383838"
                                Click="ToggleKeyVisibilityButton_Click"
                                ToolTip="Show / Hide Key">
                                <ui:SymbolIcon
                                    x:Name="ToggleKeyVisibilityIcon"
                                    FontSize="14"
                                    Foreground="#888888"
                                    Symbol="Eye16" />
                            </ui:Button>
                        </Grid>
                    </StackPanel>

                    <!-- Base URL / Endpoint Field -->
                    <StackPanel
                        x:Name="ApiUrlFieldPanel"
                        Margin="0,0,0,14"
                        Orientation="Vertical">
                        <TextBlock
                            x:Name="ApiUrlLabelText"
                            Margin="0,0,0,6"
                            FontSize="12"
                            Foreground="#CCCCCC"
                            Text="Base URL (可选自定义代理端点)" />
                        <ui:TextBox
                            x:Name="ApiUrlTextBox"
                            Height="34"
                            Padding="10,5,10,5"
                            Background="#1C1C1E"
                            BorderBrush="#383838"
                            ClearButtonEnabled="False"
                            FontSize="12.5"
                            Foreground="White"
                            PlaceholderText="https://api.openai.com/v1/chat/completions" />
                        <TextBlock
                            x:Name="ApiUrlHintText"
                            Margin="2,4,0,0"
                            FontSize="11"
                            Foreground="#888888"
                            Text="Use full endpoint URL ending with /v1/chat/completions."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Model Name Field -->
                    <StackPanel
                        x:Name="ModelFieldPanel"
                        Margin="0,0,0,14"
                        Orientation="Vertical">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="12"
                            Foreground="#CCCCCC"
                            Text="Model Name (模型名称)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="ModelComboBox"
                                Grid.Column="0"
                                Height="34"
                                Padding="10,5,10,5"
                                Background="#1C1C1E"
                                BorderBrush="#383838"
                                FontSize="12.5"
                                Foreground="White"
                                IsEditable="True" />
                            <ui:Button
                                x:Name="LoadModelsButton"
                                Grid.Column="1"
                                Height="34"
                                Margin="8,0,0,0"
                                Padding="10,4,10,4"
                                Background="#2D2D30"
                                BorderBrush="#454549"
                                Click="LoadModelsButton_Click"
                                Content="Load Models"
                                FontSize="12"
                                Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>

                    <!-- Temperature Field -->
                    <StackPanel
                        x:Name="TemperatureFieldPanel"
                        Margin="0,0,0,14"
                        Orientation="Vertical">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="12"
                            Foreground="#CCCCCC"
                            Text="Temperature (采样温度)" />
                        <ui:NumberBox
                            x:Name="TemperatureNumberBox"
                            Height="34"
                            Padding="10,5,10,5"
                            AcceptsExpression="False"
                            Background="#1C1C1E"
                            BorderBrush="#383838"
                            ClearButtonEnabled="False"
                            FontSize="12.5"
                            Foreground="White"
                            LargeChange="0.5"
                            Maximum="2"
                            Minimum="0"
                            SmallChange="0.1"
                            SpinButtonPlacementMode="Inline"
                            Value="1.0" />
                    </StackPanel>

                    <!-- Source Language Field (MTranServer) -->
                    <StackPanel
                        x:Name="SourceLangFieldPanel"
                        Margin="0,0,0,14"
                        Orientation="Vertical"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="12"
                            Foreground="#CCCCCC"
                            Text="Source Language (源语言代码)" />
                        <ui:TextBox
                            x:Name="SourceLangTextBox"
                            Height="34"
                            Padding="10,5,10,5"
                            Background="#1C1C1E"
                            BorderBrush="#383838"
                            ClearButtonEnabled="False"
                            FontSize="12.5"
                            Foreground="White"
                            PlaceholderText="en" />
                    </StackPanel>

                    <!-- LLM System Prompt Field -->
                    <StackPanel
                        x:Name="PromptFieldPanel"
                        Margin="0,0,0,6"
                        Orientation="Vertical">
                        <TextBlock
                            Margin="0,0,0,6"
                            FontSize="12"
                            Foreground="#CCCCCC"
                            Text="System Prompt (全局 LLM 提示词，需保留 {0} 作为目标语言占位符)" />
                        <ui:TextBox
                            x:Name="PromptTextBox"
                            MinHeight="56"
                            MaxHeight="90"
                            Padding="10,6,10,6"
                            AcceptsReturn="True"
                            Background="#1C1C1E"
                            BorderBrush="#383838"
                            ClearButtonEnabled="False"
                            FontSize="12"
                            Foreground="White"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Connection Test Result Banner -->
                    <Border
                        x:Name="TestResultBorder"
                        Margin="0,8,0,0"
                        Padding="10,8,10,8"
                        Background="#1C1C1E"
                        BorderBrush="#383838"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="Collapsed">
                        <TextBlock
                            x:Name="TestResultText"
                            FontSize="12"
                            Foreground="#CCCCCC"
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Background="#333337" />

            <!-- Dialog Footer -->
            <Grid Grid.Row="4" Margin="20,12,20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button
                    x:Name="TestConnectionButton"
                    Grid.Column="0"
                    Height="30"
                    Padding="12,4,12,4"
                    Background="#2D2D30"
                    BorderBrush="#454549"
                    BorderThickness="1"
                    Click="TestConnectionButton_Click">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,6,0"
                            FontSize="12"
                            Foreground="#FACC15"
                            Symbol="Flash16" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#CCCCCC"
                            Text="测试连接" />
                    </StackPanel>
                </ui:Button>

                <StackPanel
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        Width="76"
                        Height="30"
                        Margin="0,0,10,0"
                        Padding="12,4,12,4"
                        Background="#2D2D30"
                        BorderBrush="#454549"
                        BorderThickness="1"
                        Click="CancelButton_Click">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#CCCCCC"
                            Text="Cancel" />
                    </ui:Button>

                    <ui:Button
                        x:Name="SaveButton"
                        Height="30"
                        Padding="14,4,14,4"
                        Background="#0078D4"
                        BorderBrush="#2B88D8"
                        BorderThickness="1"
                        Click="SaveButton_Click">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,6,0"
                                FontSize="12"
                                Foreground="White"
                                Symbol="Checkmark16" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="Save Changes" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
